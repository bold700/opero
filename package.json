{
  "name": "opero-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:client": "pnpm --filter @opero/client dev",
    "dev:backend": "pnpm --filter @opero/backend dev",
    "predev": "docker start opero-postgres 2>/dev/null || true",
    "dev": "concurrently -n api,client -c blue,magenta \"corepack pnpm --filter @opero/backend dev\" \"corepack pnpm --filter @opero/client dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @opero/backend db:generate",
    "db:migrate": "pnpm --filter @opero/backend db:migrate",
    "db:deploy": "pnpm --filter @opero/backend db:deploy",
    "db:seed": "pnpm --filter @opero/backend db:seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
