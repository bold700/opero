// Opero backend — Prisma schema (source of truth).
//
// Translated field-for-field from client/src/lib/types.ts. The Zustand store's
// deeply-nested Project (werkbonnen → tasks → materials, quote → lineItems, etc.)
// becomes relational child tables here. Enums mirror the string unions in types.ts
// exactly so the API DTOs round-trip cleanly.
//
// Conventions:
// - id String @id @default(uuid())
// - createdAt / updatedAt on every model
// - deletedAt (soft delete) on Customer, Project, Employee, Material
// - every tenant-owned row carries orgId

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (mirror types.ts string unions)
// ---------------------------------------------------------------------------

enum UserRole {
  admin
  technician
  client
}

// User account lifecycle. `invited` = provisioned by an admin but not yet
// activated (no usable password) — cannot log in until they set one via the
// invite link. `active` = normal. `disabled` = access revoked, kept for history.
enum UserStatus {
  invited
  active
  disabled
}

// Business vs private customer (display labels "Zakelijk"/"Particulier" via i18n).
enum CustomerType {
  business
  private
}

// Employee availability (display labels "Actief"/"Verlof"/"Inactief" via i18n).
enum EmployeeStatus {
  active
  on_leave
  inactive
}

enum ProjectStatus {
  sales
  operations
  closing
}

enum Stage {
  concept
  in_progress
  ready
  done
}

enum ProjectUrgency {
  normal
  urgent
  blocked
}

enum BillingType {
  fixed
  time_and_materials
}

enum QuoteStatus {
  draft
  sent
  accepted
}

enum InvoiceStatus {
  not_started
  draft
  sent
  paid
}

enum IntakeStatus {
  planned
  completed
}

enum WorkOrderStatus {
  planned
  on_the_way
  in_progress
  blocked
  completed
}

enum CatalogCategory {
  insulation
  material
  labor
  logistics
}

enum ProjectActivityType {
  status_change
  comment
  scheduled
  system
}

// Employee job functions (types.ts Role) — distinct from auth UserRole.
enum TeamRole {
  Sales
  WorkPlanner
  Planner
  Foreman
  Technician
  Administration
  ProjectLeader
}

enum ExtraWorkRejectedBy {
  office
  client
}

// What class of object a catalog material is — the four real kinds found in the
// supplier documents, each priced on its own axis (Dutch labels via i18n:
// Isolatie, Hulpstukken, Buffervaten, Plaatwerk).
enum MaterialClass {
  insulation // pipe insulation, per Ø per meter (+ insulated fittings as variants)
  fitting // fittings-only products (Victaulic hulpstukken)
  tank // buffer vessels, priced per liter
  cladding // sheet-metal finishing / ducts, per Ø or m2
}

// What a material VARIANT is: a running metre, a specific insulated fitting,
// a vessel, or an area rate (Dutch labels via i18n: bocht, koppeling, T-stuk,
// draadappendage, flens, afsluiter, pomp, spirovent, verloop, alu-kap, buffervat).
enum MaterialComponent {
  meter // per running metre
  elbow
  coupling
  tee
  threaded_fitting
  flange
  valve
  pump
  air_separator
  reducer
  alu_cap
  buffer_vessel
  area // per m2 flat rate
}

// ---------------------------------------------------------------------------
// Tenant + auth
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  // Company / billing details (admin-managed; shown on invoices later).
  email      String?
  address    String?
  postalCode String?
  city       String?
  phone      String?
  vatNumber  String?
  // Additional letterhead details for customer-facing documents (quote PDF):
  // bank account, chamber-of-commerce number, and website.
  iban       String?
  bic        String?
  kvkNumber  String?
  website    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  customers    Customer[]
  employees    Employee[]
  materials    Material[]
  projects     Project[]
  articles     Article[]
  workTypes    WorkType[]
  materialOrders MaterialOrder[]
  auditLogs    AuditLog[]
  prejobCheckItems PrejobCheckItem[]
}

// One configurable pre-job checklist item, per organization. The admin adds /
// edits / reorders / (soft-)removes these in Settings; every work order's
// "Controle vooraf" checklist is derived from the org's ACTIVE items.
//
// `key` is a stable slug generated once at creation — it keys the boolean map
// stored on WorkOrder.prejobCheck, so renaming `label` never orphans the ticks
// already recorded on existing work orders. `active=false` is a SOFT remove:
// the item drops off new/open work orders and no longer counts toward
// "complete", but historical booleans + PDFs are untouched.
model PrejobCheckItem {
  id        String   @id @default(uuid())
  orgId     String
  key       String // stable slug; keys WorkOrder.prejobCheck; never changes
  label     String // display text (single label, shown as-is in every language)
  ordinal   Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId])
}

model User {
  id           String    @id @default(uuid())
  orgId        String
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  // Profile photo — the object key of the uploaded avatar image (or null).
  // Resolved to a URL in the auth DTO via the storage layer.
  avatar       String?
  // Per-user preferences (language + notification toggles) as a small JSON blob.
  // Server-persisted so they follow the user across devices.
  preferences  Json?
  // When the user last opened the notifications bell — anything newer counts as
  // "unread" for the badge. Null = never opened (everything counts as new).
  notificationsSeenAt DateTime?
  role         UserRole
  // Account lifecycle. `invited` users can't log in until they activate.
  status       UserStatus @default(active)
  invitedById  String?
  activatedAt  DateTime?
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  // pending TOTP secret during enrollment (before confirmation)
  pendingTotpSecret String?
  // client users link to a customer; technician users link to an employee
  customerId   String?
  employeeId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org            Organization     @relation(fields: [orgId], references: [id])
  customer       Customer?        @relation(fields: [customerId], references: [id])
  employee       Employee?        @relation(fields: [employeeId], references: [id])
  sessions          AuthSession[]
  passwordResets    PasswordReset[]
  emailChanges      EmailChange[]
  activity          ProjectActivity[]
  auditLogs         AuditLog[]
  signedWorkOrders  WorkOrder[]      @relation("WorkOrderSignedBy")
  uploadedAttachments WorkOrderAttachment[] @relation("WorkOrderAttachmentUploader")

  @@index([orgId])
  @@index([customerId])
  @@index([employeeId])
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A pending email-change: the login email only switches once the user clicks the
// confirmation link sent to newEmail. Single-use, short-lived, token hashed.
model EmailChange {
  id        String   @id @default(uuid())
  userId    String
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid())
  orgId       String
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  diff        Json?
  createdAt   DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  actor User?        @relation(fields: [actorUserId], references: [id])

  @@index([orgId])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id          String    @id @default(uuid())
  orgId       String
  name        String
  contactName String
  email       String
  phone       String
  address     String
  postalCode  String
  city        String
  type        CustomerType @default(business)
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org            Organization    @relation(fields: [orgId], references: [id])
  contactPersons ContactPerson[]
  locations      Location[]
  projects       Project[]
  users          User[]

  @@index([orgId])
}

model ContactPerson {
  id         String   @id @default(uuid())
  customerId String
  name       String
  email      String?
  phone      String?
  role       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Location {
  id         String   @id @default(uuid())
  customerId String
  label      String?
  address    String
  postalCode String
  city       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Employees (types.ts TeamMember)
// ---------------------------------------------------------------------------

model Employee {
  id        String     @id @default(uuid())
  orgId     String
  name      String
  phone     String
  email     String?
  roles     TeamRole[]
  status    EmployeeStatus @default(active)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  org   Organization @relation(fields: [orgId], references: [id])
  users User[]

  // project team assignments
  projectsAsLeader     Project[] @relation("ProjectLeader")
  projectsAsTeamLeader Project[] @relation("ProjectTeamLeader")
  projectsAsInstaller  Project[] @relation("ProjectInstallers")

  planningAsLeader     PlanningItem[] @relation("PlanningLeader")
  planningAsTeamLeader PlanningItem[] @relation("PlanningTeamLeader")
  planningAsInstaller  PlanningItem[] @relation("PlanningInstallers")

  // per-task assignments (work-order zones)
  assignedTasks WorkOrderTask[] @relation("TaskAssignee")
  assignedWorkOrders WorkOrder[] @relation("WorkOrderAssignees")

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Materials — THE catalog entity. A Material is a real product the company
// installs (e.g. "AF/Armaflex AF/2 13 mm", "Steenwolschalen", a buffervat, a
// cladding product). Its concrete purchasable items are MaterialVariants
// (size × component), each carrying ITS price. The supplier price list is NOT
// an entity — it's demoted to price-provenance attributes on the material.
// Seed data: shared/src/materials.ts. Read-only catalog for now.
// ---------------------------------------------------------------------------

model Material {
  id           String        @id @default(uuid())
  orgId        String
  // Stable english identifier, e.g. "af_armaflex_af2_13".
  key          String
  // Display/trade name (business data, typically the supplier's Dutch name).
  name         String
  class        MaterialClass
  supplier     String
  // Physical attributes (nullable — not every class has them).
  thicknessMm  Int? // fixed product thickness; null when it varies per variant
  pipeMaterial String? // "steel" | "copper" | "pvc"
  finish       String? // "none" | "white_pvc" | "reinforced_alu_foil"
  // What a variant's `size` means: "pipe_od_mm" | "pipe_dia_mm" | "tank_liters" | "flat".
  sizeUnit     String
  note         String?
  // Price provenance — where the current prices came from and how long they hold.
  priceSource    String? // e.g. "Prijslijst Merwede 2026-2029"
  priceValidFrom DateTime?
  priceValidTo   DateTime?
  priceNote      String? // e.g. indexation clause
  // Document order for stable display.
  ordinal      Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org      Organization      @relation(fields: [orgId], references: [id])
  variants MaterialVariant[]

  @@unique([orgId, key])
  @@index([orgId])
}

// A concrete purchasable item of a material: one size × component combination
// (e.g. Ø22 elbow of AF/2), with ITS unit price.
model MaterialVariant {
  id          String            @id @default(uuid())
  materialId  String
  // Size row key as printed in the source: "17".."324" (Ø mm), "150".."2500"
  // (liters), or "flat". String — combined sizes like "21/22" exist.
  size        String
  component   MaterialComponent
  // Column thickness where the source varies it (Kooltherm 15–80, steenwol
  // 25–50, Victaulic 13/19); null when the material has one fixed thickness.
  thicknessMm Int?
  // "m" | "piece" | "m2"
  unit        String
  // EUR excluding VAT — the SELLING price (verkoopprijs) is an attribute of the
  // variant.
  unitPrice   Float
  // EUR excluding VAT — the PURCHASE / cost price (inkoopprijs). Nullable: the
  // supplier docs only list selling prices, so an admin fills cost in later.
  // Margin = unitPrice − costPrice. Admin-only; never exposed to other roles.
  costPrice   Float?
  // Source row/column order for stable display.
  ordinal     Int

  material      Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  taskMaterials TaskMaterial[]
  extraWork     ExtraWork[]

  @@unique([materialId, size, component, thicknessMm])
  @@index([materialId])
}

// Combines spec "Create Order" with the store PurchaseList.
model MaterialOrder {
  id         String              @id @default(uuid())
  orgId      String
  projectId  String?
  createdAt  DateTime            @default(now())
  receivedAt DateTime?
  updatedAt  DateTime            @updatedAt

  org     Organization        @relation(fields: [orgId], references: [id])
  project Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items   MaterialOrderItem[]

  @@index([orgId])
  @@index([projectId])
}

model MaterialOrderItem {
  id              String   @id @default(uuid())
  orderId         String
  materialName    String
  quantityToOrder Int
  unit            String
  supplier        String

  order MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Catalog (types.ts CatalogItem) + WorkType (managed list)
// ---------------------------------------------------------------------------

model Article {
  id              String          @id @default(uuid())
  orgId           String
  category        CatalogCategory
  name            String
  unit            String
  unitPrice       Float
  defaultQuantity Float           @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model WorkType {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id])
  projects Project[]
  tasks    WorkOrderTask[]

  @@unique([orgId, name])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Project (the lifecycle core) — header fields; nested arrays become children
// ---------------------------------------------------------------------------

model Project {
  id            String         @id @default(uuid())
  orgId         String
  projectNumber String
  name          String?
  customerId    String
  customerName  String
  locationId    String?
  address       String
  postalCode    String
  city          String
  contactName   String?
  contactPhone  String?
  instructions  String?
  // Work type is a managed reference (WorkType). workTypeId is the source of
  // truth; insulationType is a denormalized display mirror set from the chosen
  // WorkType.name so list/read paths stay simple and never hold free-text drift.
  workTypeId    String?
  insulationType String
  squareMeters  Int            @default(0)
  description   String?
  workTypes     String[]
  exclusions    String?
  billingType   BillingType?
  archived      Boolean        @default(false)
  stage         Stage          @default(concept)
  status        ProjectStatus  @default(sales)
  urgency       ProjectUrgency @default(normal)
  // Free-text blocker (a user-entered reason). When the blocker is a system
  // default, blockerKey holds an i18n key instead (rendered client-side).
  blocker       String?
  blockerKey    String?
  // The next action, stored as a language-neutral i18n key (e.g. "sendQuote").
  // The client renders it via t(`domain.nextStep.${nextStepKey}`).
  nextStepKey   String
  signature     String?
  materialsReady Boolean       @default(false)
  value         Int            @default(0)

  // survey (types.ts Opname): photos + notes only
  surveyPhotos  String[]
  surveyNotes   String        @default("")

  // team
  projectLeaderId String?
  teamLeaderId    String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])
  location Location?    @relation(fields: [locationId], references: [id])
  workType WorkType?    @relation(fields: [workTypeId], references: [id])

  projectLeader Employee?  @relation("ProjectLeader", fields: [projectLeaderId], references: [id])
  teamLeader    Employee?  @relation("ProjectTeamLeader", fields: [teamLeaderId], references: [id])
  installers    Employee[] @relation("ProjectInstallers")

  intake               Intake?
  handover             Handover?
  deliveryChecklist    DeliveryChecklist?
  workOrders           WorkOrder[]
  materialRequirements MaterialRequirement[]
  tasks                ProjectTask[]
  activity             ProjectActivity[]
  materialOrders       MaterialOrder[]

  @@index([orgId])
  @@index([customerId])
  @@index([status])
}

model Intake {
  id                 String       @id @default(uuid())
  projectId          String       @unique
  status             IntakeStatus @default(planned)
  plannedDate        String?
  contactName        String
  contactEmail       String
  contactPhone       String
  address            String
  insulationType     String
  squareMeters       Int          @default(0)
  cavityWidthMm      Int?
  existingInsulation Boolean?
  buildingType       String?
  accessibility      String?
  photos             String[]
  notes              String       @default("")
  risks              String       @default("")
  estimatedMaterials String[]
  estimatedLaborHours Int         @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Quote {
  id           String      @id @default(uuid())
  // Billing is per-werkbon: one quote per werkbon (not per project).
  workOrderId  String      @unique
  status       QuoteStatus @default(draft)
  amount       Int         @default(0)
  sentDate     String?
  acceptedDate String?

  workOrder WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  lineItems QuoteLineItem[]
}

model QuoteLineItem {
  id            String   @id @default(uuid())
  quoteId       String
  catalogItemId String?
  workType      String?
  description   String
  size          String?
  quantity      Float
  unit          String
  unitPrice     Float
  ordinal       Int      @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// WorkOrders — the headline module
// ---------------------------------------------------------------------------

model WorkOrder {
  id                 String        @id @default(uuid())
  projectId          String
  title              String
  drawings           String[]
  approvedBySupervisor Boolean     @default(false)
  ordinal            Int           @default(0)
  // Per-work-order sign-off. A project has many work orders, so completion is a
  // property of THE work order, not the project. signedAt set → this work order
  // is signed off and locked for editing; sibling work orders and the project's
  // own stage are unaffected.
  // `signature` holds the object key of the drawn signature image. signedByName
  // is the name the signer typed at sign-off (often the customer's, distinct
  // from the logged-in user in signedById), printed on the work order record.
  signature          String?
  signedByName       String?
  signedAt           DateTime?
  signedById         String?
  // Pre-job check + dispatch gate. A monteur may not be dispatched until the
  // pre-job checklist is complete AND (if required for this werkbon) a pre-job
  // photo exists. The checklist ITEMS are per-werkbon (WorkOrderPrejobItem),
  // snapshotted from the org template at creation and editable by the office on
  // this werkbon only. `prejobCheck` (legacy JSON map) is retired — item `done`
  // now lives on the item rows. `prejobPhotos` holds object keys.
  // `prejobPhotoRequired`: null = not required (default); true = a photo gates
  // dispatch. dispatchedAt set → the job has been sent out.
  prejobCheck        Json?
  prejobPhotoRequired Boolean?
  prejobPhotos       String[]      @default([])
  prejobItems        WorkOrderPrejobItem[]
  dispatchedAt       DateTime?
  dispatchedById     String?
  // Denormalized list status ("open" | "on_the_way" | "urgent" | "done"), derived
  // from project urgency + task completion. Kept in sync by
  // recomputeWorkOrderStatus() so the list endpoint can filter/count/paginate on a
  // real indexed column instead of computing over the whole table in app code.
  listStatus         String        @default("open")
  // Customer-facing quote (offerte) document identity — assigned on the first
  // quote-PDF export and stable afterwards. Format YYYYNNNN (e.g. 20260063).
  quoteNumber        String?
  quoteDate          DateTime?
  // The werkbon is the scheduled VISIT — its own date(s), possibly multi-day.
  // Scheduling lives here, not on the project (a project has many werkbonnen).
  plannedDate        String?
  plannedEndDate     String?
  // Billing is per-werkbon: this werkbon's offertebedrag (sum of its line items).
  value              Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signedBy User?           @relation("WorkOrderSignedBy", fields: [signedById], references: [id], onDelete: SetNull)
  // The monteur(s) assigned to THIS werkbon. A job/visit can be split across a
  // crew, so assignment is many-to-many at the werkbon level (not per-zone).
  assignees Employee[]     @relation("WorkOrderAssignees")
  planningItems PlanningItem[]
  tasks    WorkOrderTask[]
  // Billing (per-werkbon) + extra work live on the werkbon.
  quote     Quote?
  invoice   Invoice?
  extraWork ExtraWork[]
  // Uploaded documents (PDFs/images) for the whole job — quotes, floor plans,
  // permits, supplier docs. Werkbon-level, not per-zone (see the attachments
  // panel). Distinct from `drawings` (a separate, older key[] field).
  attachments WorkOrderAttachment[]

  @@index([projectId])
  @@index([listStatus])
}

// One pre-job checklist item, PER WORK ORDER. Snapshotted from the org template
// (PrejobCheckItem) when the work order is created, then editable by the office
// on this work order only — so editing the template never mutates existing
// werkbonnen, and editing one werkbon never touches the template or others.
// `done` lives here (not a separate map), so it can't drift from the item set.
// `key` is stable within the work order (keeps historical PDFs coherent).
model WorkOrderPrejobItem {
  id          String  @id @default(uuid())
  workOrderId String
  key         String
  label       String
  done        Boolean @default(false)
  ordinal     Int     @default(0)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, key])
  @@index([workOrderId])
}

// A file attached to a work order (PDF or image). Unlike `drawings` (a bare
// key[]), this keeps the original filename + size + content type + uploader,
// so the attachments list can show real file names and open them.
model WorkOrderAttachment {
  id           String   @id @default(uuid())
  workOrderId  String
  key          String // storage object key (orgId/scope/entityId/uuid.ext)
  filename     String // sanitized original name, for display
  contentType  String
  size         Int
  uploadedById String?
  createdAt    DateTime @default(now())

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("WorkOrderAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([workOrderId])
}

model WorkOrderTask {
  id           String   @id @default(uuid())
  workOrderId  String
  description  String   @default("")
  done         Boolean  @default(false)
  day          String?
  // Each task (zone) carries its own work type + assigned technician — different
  // zones of one work order can be different work, done by different people.
  workTypeId   String?
  assigneeId   String?
  beforePhotos String[]
  resultPhotos String[]
  startedAt    String?
  endedAt      String?
  hours        Float?
  note         String?
  ordinal      Int      @default(0)

  workOrder WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workType  WorkType?      @relation(fields: [workTypeId], references: [id], onDelete: SetNull)
  assignee  Employee?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  materials TaskMaterial[]

  @@index([workOrderId])
}

// The shared line-item row: feeds quote (quantity×price), workOrder (onSite),
// and invoice (usedQuantity×price).
model TaskMaterial {
  id           String  @id @default(uuid())
  taskId       String
  label        String?
  name         String  @default("")
  quantity     Float   @default(0)
  usedQuantity Float?
  unit         String  @default("")
  diameter     Float?
  // Selling price snapshot (verkoopprijs) at the time the line was added.
  unitPrice    Float?
  // Cost price snapshot (inkoopprijs) at the time the line was added from the
  // catalog. Snapshotting keeps historical margin stable if catalog cost later
  // changes. Null for free-text lines or lines added before cost was set.
  // Admin-only; stripped from every non-admin DTO.
  costPrice    Float?
  onSite       Boolean @default(false)
  done         Boolean @default(false)
  note         String?
  ordinal      Int     @default(0)
  // Set when the line was picked from the materials catalog — traces the line
  // back to its variant. Null for free-text lines; kept (SetNull) if the
  // variant is ever removed.
  variantId    String?

  task    WorkOrderTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  variant MaterialVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// ExtraWork, handover, delivery checklist, project tasks
// ---------------------------------------------------------------------------

model ExtraWork {
  id               String               @id @default(uuid())
  workOrderId      String
  description      String
  label            String?
  name             String?
  quantity         Float?
  unit             String?
  diameter         Float?
  unitPrice        Float?
  // Cost price snapshot (inkoopprijs), set when the item was picked from the
  // catalog. Admin-only; stripped from every non-admin DTO. Null for free-text
  // meerwerk (which carries no price until an admin sets one).
  costPrice        Float?
  amount           Int                  @default(0)
  photos           String[]
  createdAt        String
  done             Boolean              @default(false)
  approvedByOffice Boolean              @default(false)
  approvedByClient Boolean              @default(false)
  rejected         Boolean              @default(false)
  rejectedBy       ExtraWorkRejectedBy?
  // Set when the item was picked from the materials catalog — traces it back
  // to its variant. Null for free-text meerwerk; kept (SetNull) if the variant
  // is ever removed.
  variantId        String?

  workOrder WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  variant   MaterialVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([variantId])
}

model Handover {
  id          String   @id @default(uuid())
  projectId   String   @unique
  photos      String[]
  restpunten  String   @default("")
  signedBy    String?
  completedAt String?

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklist HandoverItem[]
}

model HandoverItem {
  id          String  @id @default(uuid())
  handoverId  String
  // i18n key (rendered via t(`domain.checklist.${labelKey}`)).
  labelKey    String
  done        Boolean @default(false)
  ordinal     Int     @default(0)

  handover Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@index([handoverId])
}

model DeliveryChecklist {
  id        String                  @id @default(uuid())
  projectId String                  @unique
  qualityNotes String?

  project Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   DeliveryChecklistItem[]
}

model DeliveryChecklistItem {
  id          String  @id @default(uuid())
  checklistId String
  // i18n key for the checklist item (rendered via t(`domain.checklist.${labelKey}`)).
  labelKey    String
  complete    Boolean @default(false)
  ordinal     Int     @default(0)

  checklist DeliveryChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model ProjectTask {
  id        String   @id @default(uuid())
  projectId String
  label     String
  done      Boolean  @default(false)
  source    String // "offerte" | "standaard"
  ordinal   Int      @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Material requirements, planning, invoice, activity
// ---------------------------------------------------------------------------

model MaterialRequirement {
  id                   String  @id @default(uuid())
  projectId            String
  materialId           String
  materialName         String
  quantityNeeded       Int
  quantityInStock      Int
  unit                 String
  supplier             String
  expectedDeliveryDate String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model PlanningItem {
  id              String @id @default(uuid())
  // A planning slot belongs to a WERKBON (the scheduled visit), not the project.
  workOrderId     String
  date            String
  startTime       String
  endTime         String
  projectLeaderId String?
  teamLeaderId    String?
  vehicle         String @default("")

  workOrder     WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  projectLeader Employee?  @relation("PlanningLeader", fields: [projectLeaderId], references: [id])
  teamLeader    Employee?  @relation("PlanningTeamLeader", fields: [teamLeaderId], references: [id])
  installers    Employee[] @relation("PlanningInstallers")

  @@index([workOrderId])
}

model Invoice {
  id                  String        @id @default(uuid())
  // Billing is per-werkbon: one invoice per werkbon (not per project).
  workOrderId         String        @unique
  status              InvoiceStatus @default(not_started)
  acceptedQuoteAmount Int           @default(0)
  extraWorkAmount     Int           @default(0)
  materialsAmount     Int           @default(0)
  laborAmount         Int           @default(0)
  sentDate            String?
  paidDate            String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model ProjectActivity {
  id         String              @id @default(uuid())
  projectId  String
  userId     String?
  type       ProjectActivityType
  // System events store a language-neutral messageKey + structured params; the
  // client renders them via i18n (t(`activity.${messageKey}`, params)). Internals
  // are English; no display prose is stored. `body` holds free text for the
  // `comment` type only (the user's own words, not translatable).
  messageKey String?
  params     Json?
  body       String?
  fromStatus ProjectStatus?
  toStatus   ProjectStatus?
  createdAt  DateTime            @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([projectId])
}
