# Postgres connection (Supabase-hosted in prod; local Docker in dev).
DATABASE_URL="postgresql://opero:opero_dev_pw@localhost:5433/opero?schema=public"

# Auth (Phase 2). Generate strong random values in real environments.
JWT_SECRET="dev-only-change-me-please-32-chars-min"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Server
PORT="8787"
# Comma-separated allowed origins for CORS (the web app's URL).
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# Object storage (Phase 7) — left blank until then.
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
