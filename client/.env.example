# Shared production API. The browser always sends the current customer workspace
# label in X-Opero-Tenant when it runs on a tenant subdomain.
VITE_API_URL="http://localhost:8787/api"

# Leave blank for local development or a single-domain installation. In
# production this is the shared domain below customer workspaces, for example
# "alpero.nl" for https://wdbisolatie.alpero.nl.
VITE_TENANT_ROOT_DOMAIN=""
