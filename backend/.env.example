# PostgreSQL connection (Supabase session pooler in production; local Docker in development).
DATABASE_URL="postgresql://opero:opero_dev_pw@localhost:5433/opero?schema=public"

# Auth (Phase 2). Generate strong random values in real environments.
JWT_SECRET="dev-only-change-me-please-32-chars-min"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Server
PORT="8787"
# Comma-separated allowed origins for CORS (the web app's URL).
CORS_ORIGIN="http://localhost:3000"
# Optional root domain for customer workspaces, e.g. "alpero.nl". This allows
# https://<organization-slug>.alpero.nl in CORS and tenant-specific email links.
TENANT_ROOT_DOMAIN=""
# Public origin of the WEB app â€” every emailed link (invitation, password reset,
# email confirmation) is built from this.
# REQUIRED IN PRODUCTION: the app refuses to boot without it when
# NODE_ENV=production. The localhost value below is a dev-only convenience; left
# unset in a deploy it would send real users to their own machine.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Object storage â€” S3-compatible (a private Supabase Storage bucket in production). Leave ALL blank to
# use the local-disk dev fallback (writes to backend/var/uploads, served via
# GET /uploads/:key). Fill all five to use real object storage.
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_REGION="eu-west-3"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
# Public origin of this API (for absolute /uploads URLs on the local adapter).
# Defaults to http://localhost:PORT. Set to the API's public URL in production
# if you keep the local-disk adapter; not needed when STORAGE_* points at S3.
PUBLIC_API_URL=""

# Transactional email â€” Resend. Set both to send real emails (password reset).
# Leave blank in dev to log emails to the console instead. EMAIL_FROM must use a
# domain verified in your Resend account, e.g. "Opero <no-reply@opero.nl>".
RESEND_API_KEY=""
EMAIL_FROM=""
