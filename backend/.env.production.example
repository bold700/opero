# Supabase PostgreSQL shared session-pooler connection string.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# Generate a unique random value with at least 32 characters.
JWT_SECRET="replace-with-a-new-random-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

NODE_ENV="production"
PORT="8787"
APP_URL="https://PRODUCT_DOMAIN"
CORS_ORIGIN="https://PRODUCT_DOMAIN"
TENANT_ROOT_DOMAIN="PRODUCT_DOMAIN"
PUBLIC_API_URL="https://api.PRODUCT_DOMAIN"

STORAGE_BUCKET="uploads"
STORAGE_ENDPOINT="https://PROJECT_REF.storage.supabase.co/storage/v1/s3"
STORAGE_REGION="PROJECT_REGION"
STORAGE_ACCESS_KEY="replace-with-supabase-s3-access-key"
STORAGE_SECRET_KEY="replace-with-supabase-s3-secret-key"

RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="Opero <no-reply@PRODUCT_DOMAIN>"
