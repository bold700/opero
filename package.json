{
  "name": "opero-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "pnpm --filter @opero/backend exec prisma migrate deploy && pnpm --filter @opero/backend start",
    "dev:client": "pnpm --filter @opero/client dev",
    "dev:backend": "pnpm --filter @opero/backend dev",
    "predev": "bash scripts/dev-db.sh",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @opero/backend db:generate",
    "db:migrate": "pnpm --filter @opero/backend db:migrate",
    "db:deploy": "pnpm --filter @opero/backend db:deploy",
    "db:seed": "pnpm --filter @opero/backend db:seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "^10.0.3",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "typescript-eslint": "8.70.1"
  },
  "pnpm": {
    "overrides": {
      "body-parser@1.20.5": "1.20.6",
      "brace-expansion@1.1.15": "1.1.18",
      "brace-expansion@2.1.1": "2.1.4",
      "deepmerge-ts@7.1.5": "8.0.0",
      "qs@6.15.2": "6.16.0"
    }
  }
}
